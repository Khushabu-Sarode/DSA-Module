package Array2D;

public class Maximumsum {

	public static void main(String[] args) {
		int[][] arr = {
			    {1, 2, 3},
			    {4,5,6},
			    {7,8,9}
		};
		
		int r = arr.length;
		int c = arr[0].length;
		
		int maxsum = Integer.MIN_VALUE;
		for(int i=0;i<r;i++) {
			
			int csum = 0;
			for(int j=0;j<c;j++) {
				csum = csum + arr[i][j];
			}
			
			if(csum > maxsum) {
				maxsum = csum;
			}
			
		}
		
		System.out.println(maxsum);

	}

}
