package Array2D;

public class Rotate90Degree {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int[][] arr = {
			    {1, 2, 3},
			    {4,5,6},
			    {7,8,9}
		};
		
		int r = arr.length;
		int c = arr[0].length;
		
		for(int i=0;i<r;i++) {
			for(int j=0;j<c;j++) {
				System.out.println(arr[j][i]);
			}
		}
	}

}
